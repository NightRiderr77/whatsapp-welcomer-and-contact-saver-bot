# Copy to .env next to docker-compose.yml. Never commit the real one.

# Required — the dashboard will not start without it.
DASH_PASSWORD=pick-something-long

# Optional — link WhatsApp with an 8-digit code instead of scanning a QR.
# PAIR_NUMBER=947XXXXXXXX

# Optional — memory. The bot sweeps the browser above the soft mark, purges
# above the hard mark, and restarts itself if that still does not bring it
# down. It picks both from the size of the server, so leave these alone
# unless you want to overrule it. The startup log prints what it chose.
# MEM_SOFT_MB=1500
# MEM_HARD_MB=2500
# MEM_CHECK_MINUTES=5
# MEM_RESTART=on

# Optional — set to on to let Chromium decode avatars and thumbnails again.
# Off is the default and saves a lot of memory on an account with many chats.
# IMAGES=off
